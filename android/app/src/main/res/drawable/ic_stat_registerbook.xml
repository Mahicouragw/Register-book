<?xml version="1.0" encoding="utf-8"?>
<!-- Small icon shown in the Android status bar for notifications.
     Android draws this as a MASK: only the alpha channel is used and the
     whole shape is tinted with notification_color, so it must be a solid
     white-on-transparent glyph. Anything with colour or fine detail turns
     into an unreadable white blob, which is why this is not the launcher
     icon. A register/ledger book with a bookmark, matching the app icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- book cover -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M6,2h12a2,2 0 0 1 2,2v16a2,2 0 0 1 -2,2H6a2,2 0 0 1 -2,-2V4a2,2 0 0 1 2,-2zM6,4v16h12V4H6z" />

    <!-- ruled lines inside the cover -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M8,7h8v1.5H8zM8,11h8v1.5H8zM8,15h5v1.5H8z" />

    <!-- bookmark ribbon -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15,2h3v6l-1.5,-1.2L15,8z" />
</vector>
