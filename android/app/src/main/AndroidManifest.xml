<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google login returns here: Chrome hands the OAuth redirect
                 back to the app via this deep link (com.registerbook.community://auth).
                 The app exchanges the code for a session (see auth.js). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.registerbook.community" android:host="auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- ================= Firebase Cloud Messaging =================
             A push that arrives while the app is closed (or in the
             background) is drawn by the FCM SDK itself, not by this app.
             Two values decide whether that notification is actually shown:

               default_notification_channel_id
                   The channel to post on. If it does not exist, Android
                   throws the notification away with no error anyone sees.
                   MainActivity creates this channel at startup, and the
                   server always sends the same id (see _shared/fcm.js).
                   Android 8+ requires it to be named here; this is the
                   single most common cause of "notifications don't work
                   when the app is closed".

               default_notification_icon / _color
                   Android uses the launcher icon as a fallback, which is a
                   full-colour bitmap and gets drawn as a white blob. A
                   monochrome icon is used instead. -->

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="registerbook_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_registerbook" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

    </application>

    <!-- Permissions -->
    <!-- Internet + network state: Supabase sync, realtime, calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Self-update: lets the app hand a downloaded .apk to the Android
         package installer (the in-app "Update" button). Without this the
         installer sheet refuses to open on Android 8.0+. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Calls: microphone + camera (video calls) + audio routing -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Notifications (Android 13+ asks at runtime; declared here so the
         system prompt can appear). Vibration for the notification buzz. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
